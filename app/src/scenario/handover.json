  "beats": [
    { "beat": "held_1", "template": "conveyor-4", "at": 3 },
    { "beat": "held_2", "template": "arm-170", "at": 3.6 },
    { "beat": "held_3", "template": "conveyor-3", "at": 4.2 },
    { "beat": "held_4", "template": "oven-400", "at": 4.8 },
    { "beat": "late_1", "template": "lift-1400", "after": "conveyor-3", "delay_s": 6 },
    { "beat": "late_2", "template": "conveyor-2", "after": "lift-1400", "delay_s": 4 }
  ]
