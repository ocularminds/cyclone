      "rationale": "Pick wave 1 starts at 06:10; 3% more belt speed matches the picker headcount.",
      "ttl_s": 1800,
      "amend": { "param": "speed_pct", "min": 0, "max": 20, "step": 1, "unit": "%" },
      "downstream": { "system": "line-plc", "operation": "set_conveyor_speed" }
    },
    {
      "key": "oven-400",
      "agent_id": "thermal-agent",
      "tool": "set_oven_setpoint",
      "args": { "zone": "B", "setpoint_c": 400 },
      "target": { "asset_id": "oven-b" },
      "policy": { "rule_id": "oven.setpoint.within_limit", "requires": "single" },
      "risk": { "level": 1, "reasons": ["Setpoint change of +20°C"] },
