<!-- All dimensions are centimetres. Override Horizon's 80 cm button minimum. -->
<style>
  @font-face { font-family: atkinson; src: url(../assets/fonts/atkinson400.ttf); font-weight: 400; }
  @font-face { font-family: atkinson; src: url(../assets/fonts/atkinson700.ttf); font-weight: 700; }
  @font-face { font-family: manrope; src: url(../assets/fonts/manrope700.ttf); font-weight: 700; }
  .root { font-family: atkinson; flex-direction: column; width: 28; height: 26; min-width: 0; padding-top: 1.2; padding-bottom: 1.2; padding-left: 1.2; padding-right: 1.2; gap: 0.8; }
  .title { font-family: manrope; font-size: 1.5; font-weight: 700; height: 2.25; color: #142B36; }
  .note { font-size: 0.9; line-height: 1.25; height: 3.1; color: #526773; }
  .body { flex-direction: column; height: 12.1; gap: 0.8; }
  .button { width: 25.6; min-width: 0; max-width: 25.6; height: 3.5; min-height: 3.5; padding-left: 0.5; padding-right: 0.5; padding-top: 0; padding-bottom: 0; border-width: 0.08; border-radius: 0.6; }
  .label { font-family: atkinson; font-size: 1; font-weight: 700; line-height: 1.2; color: #142B36; }
  .footer { flex-direction: row; gap: 0.8; height: 3.5; }
  .nav { width: 12.4; min-width: 0; max-width: 12.4; height: 3.5; min-height: 3.5; padding-left: 0.4; padding-right: 0.4; padding-top: 0; padding-bottom: 0; border-width: 0.08; border-radius: 0.6; }
</style>
<Panel id="settings-root" class="root">
  <div id="title" class="title">Settings</div>
  <div id="status" class="note">Choose a page. Your task stays here.</div>
  <div class="body">
    <Button id="action-a" class="button"><ButtonLabel id="label-a" class="label">Input</ButtonLabel></Button>
    <Button id="action-b" class="button"><ButtonLabel id="label-b" class="label">Display and comfort</ButtonLabel></Button>
    <Button id="action-c" class="button"><ButtonLabel id="label-c" class="label">Session</ButtonLabel></Button>
  </div>
  <div class="footer">
    <Button id="back" class="nav"><ButtonLabel id="back-label" class="label">Back</ButtonLabel></Button>
    <Button id="close" class="nav"><ButtonLabel id="close-label" class="label">Close</ButtonLabel></Button>
  </div>
</Panel>
