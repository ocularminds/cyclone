{
  "name": "cyclone-relay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cyclone live-mode relay: policy-gate webhook intake, client decisions, dossier verification.",
  "scripts": {
    "start": "tsx src/main.ts",
    "dev": "tsx watch src/main.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check:fixtures": "tsx src/record.ts check",
    "record:export": "tsx src/record.ts export",
    "keygen": "tsx src/tools.ts keygen",
    "register:key": "tsx src/tools.ts register-key",
    "policy:push": "tsx src/tools.ts push-policy"
  },
  "dependencies": {
    "@decionis/verify": "^0.5.0",
    "@fastify/websocket": "^11.3.4",
    "fastify": "^5.12.7",
    "tsx": "^4.23.15",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
